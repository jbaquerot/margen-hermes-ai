# LEGACY DESIGN: DO NOT INSTALL with the pinned Hermes revision.
# It rejects per-profile gateways. Native shared-gateway integration is pending;
# see docs/deployment.md. This template is retained only for design traceability.
[Unit]
Description=Hermes Gateway — Margen
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/claw/.hermes/hermes-agent
ExecStart=/home/claw/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main -p margen gateway run
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=default.target
